# PostgreSQL / PostGIS
DB_PORT=5433
DB_PASSWORD=devpassword
DATABASE_URL=postgres://pyrosync:devpassword@localhost:5433/pyrosync?sslmode=disable

# NASA FIRMS API (keep empty if running strictly offline/archive mode)
FIRMS_MAP_KEY=

# Admin endpoint token (leave empty to disable /api/v1/admin/* routes)
ADMIN_TOKEN=

# Backend HTTP server
HTTP_ADDR=:8080
ALLOWED_ORIGINS=http://localhost:3000
INGEST_INTERVAL_MIN=60
LOG_LEVEL=info

# Frontend build-time API base
NEXT_PUBLIC_API_BASE=http://localhost:8080/api/v1

# Caddy production site address
SITE_ADDRESS=localhost
