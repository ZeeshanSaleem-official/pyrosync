{$SITE_ADDRESS} {
	encode zstd gzip

	header {
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "no-referrer"
		Content-Security-Policy "default-src 'self'; img-src 'self' data: blob: https://server.arcgisonline.com; style-src 'self' 'unsafe-inline'; script-src 'self'; connect-src 'self' https://server.arcgisonline.com; worker-src 'self' blob:; font-src 'self'"
	}

	handle /api/* {
		reverse_proxy app:8080
	}

	handle /_next/static/* {
		header Cache-Control "public, max-age=31536000, immutable"
		root * /srv/web
		file_server
	}

	handle {
		root * /srv/web
		try_files {path} {path}/index.html
		file_server
	}
}
